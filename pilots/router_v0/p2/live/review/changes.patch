+def list_jobs(*, jobs_dir=JOBS):
+    """Every job in the jobs directory, one line each, sorted by job id: what status says about a job's money, for
+    all of them at once. Read only: it takes no lock, opens no EventLog and writes nothing. A directory is a job only
+    if it holds a job.json; one that cannot be read (or is not valid JSON) is listed as '<directory> unreadable' and
+    the other jobs are still listed."""
+    root = Path(jobs_dir)
+    try:
+        entries = sorted((p for p in root.iterdir() if p.is_dir()), key=lambda p: p.name)
+    except OSError:                                  # missing (or not a directory): nothing to list
+        return "no jobs"
+    out = []
+    for d in entries:
+        line = _job_line(d)
+        if line is not None:
+            out.append(line)
+    return "\n".join(out) if out else "no jobs"
+
+
+def _job_line(job_dir):
+    """One job's line, or None if the directory holds no job.json."""
+    file = job_dir / "job.json"
+    if not file.exists():
+        return None
+    try:
+        d = json.loads(file.read_text(encoding="utf-8"))
+        state, cap = d["state"], float(d["max_usd"])
+        spent = runs_spent_nano(job_dir / "runs", d.get("stages")) / 1e9
+    except (OSError, ValueError, KeyError, TypeError):  # unreadable, not JSON, or not a job file after all
+        return f"{job_dir.name} unreadable"
+    return f"{job_dir.name} {state} spent ${spent:.4f} of ${cap:.2f}"
+
+
 def status(job_id, *, jobs_dir=JOBS):
     """A read-only summary (no lock): state, money, stages, and the draft to approve with its sha."""
     job = open_job(job_id, jobs_dir)
