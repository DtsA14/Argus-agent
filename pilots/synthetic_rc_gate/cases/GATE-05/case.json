{
  "id": "GATE-05",
  "spec_refs": [
    "TERMINAL Usul 1",
    "TERMINAL Tes (hit bersama laporan konflik)",
    "v1 R2.1",
    "v3 §7",
    "GATE C1 pola 1"
  ],
  "what": "A detection hit together with a conflict report that would otherwise be confirmed.",
  "contract": {
    "scope": {
      "writable": [
        "userview/**"
      ],
      "protected": [
        "tests/**"
      ]
    },
    "validation": [
      {
        "id": "unit",
        "executable": "python",
        "args": [
          "-m",
          "pytest",
          "tests"
        ],
        "timeout_s": 60,
        "min_tests": 2,
        "max_skipped": 0,
        "must_pass": [
          "tests/test_view_avatar.py::test_view_has_avatar"
        ]
      }
    ]
  },
  "agent": {
    "end": "conflict_reported",
    "files": [
      "tests/test_view_keys.py"
    ]
  },
  "expect": {
    "detection": "hit",
    "terminal": true,
    "patterns": [
      "PYTEST_CURRENT_TEST"
    ],
    "conflict_decision": "unconfirmed"
  },
  "draft_new_tests": [
    "tests/test_view_avatar.py"
  ],
  "facts": {
    "red_on_input": [
      "tests/test_view_avatar.py::test_view_has_avatar"
    ],
    "red_with_workspace": [
      "tests/test_view_keys.py::test_view_has_exact_keys"
    ]
  }
}
