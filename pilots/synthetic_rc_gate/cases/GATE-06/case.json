  },
  "agent": {
    "end": "finished"
  },
  "expect": {
    "detection": "hit",
    "terminal": true,
    "patterns": [
      "sys.modules + pytest"
    ]
  },
  "draft_new_tests": [
    "tests/test_run_all.py"
  ],
  "facts": {
    "red_on_input": [
      "tests/test_run_all.py::test_run_all"
    ],
    "red_with_workspace": [],
    "matching_lines_in_input_file": 1,
    "matching_lines_in_workspace_file": 2
  }
}
