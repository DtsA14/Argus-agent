{
  "id": "RC-11",
  "spec_refs": [
    "v1 R2.5",
    "v3 C1(c)",
    "v1 R2.4",
    "v1 §5 tes 3 dan 5"
  ],
  "what": "A required new draft test is red too (half-built feature); the agent names the old file and the new test file.",
  "contract": {
    "scope": {
      "writable": [
        "tags/**"
      ],
      "protected": [
