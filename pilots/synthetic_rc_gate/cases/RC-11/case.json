        "executable": "python",
        "args": [
          "-m",
          "pytest",
          "tests"
        ],
        "timeout_s": 60,
        "min_tests": 3,
        "max_skipped": 0,
        "must_pass": [
          "tests/test_clean_new.py::test_lowercased",
          "tests/test_clean_new.py::test_duplicates_dropped"
        ]
      }
    ]
  },
  "agent": {
    "end": "conflict_reported",
    "files": [
      "tests/test_clean_old.py",
      "tests/test_clean_new.py"
    ]
  },
  "expect": {
    "decision": "unconfirmed",
    "reasons_include": [
      "must_pass node red: test_duplicates_dropped",
      "red node in a draft new-test file"
    ]
  },
  "draft_new_tests": [
    "tests/test_clean_new.py"
  ],
  "facts": {
    "red_on_input": [
      "tests/test_clean_new.py::test_lowercased",
      "tests/test_clean_new.py::test_duplicates_dropped"
    ],
    "red_with_workspace": [
      "tests/test_clean_old.py::test_case_preserved",
      "tests/test_clean_new.py::test_duplicates_dropped"
    ]
  }
