{
  "contract": "argus_self_contract",
  "version": 1,
  "inputs": {
    "workspace": "fixtures/repos/argus_self_contract",
    "issue": "acceptance/contract.py: validate() accepts a must_pass test that the validation's own `python -m unittest discover` options can never run, and a test listed twice in must_pass. Such a contract can never pass. Expected: validate reports every such required test in an error that names its validation (validation[i]) and the test. It must follow what unittest discovery really does with -s, -t (default: the start directory), -p (default test*.py) and -k, accept every test that discovery can run, and not reject a test only because its file might not exist (the validator does not read files). Everything else about validation stays as it is. Do not change the tests."
  },
  "scope": {
    "writable": [
      "acceptance/contract.py"
    ],
    "protected": [
      "pilot_tests/**"
    ]
  },
  "artifacts": [
    {
      "path": "SUMMARY.json",
      "type": "json",
      "schema": "claims_v2"
    }
  ],
  "validation": [
    {
      "id": "unit",
      "executable": "python",
      "args": [
        "-m",
        "unittest",
        "discover",
        "-s",
        "pilot_tests",
        "-t",
        ".",
        "-p",
        "test_contract_regression.py"
      ],
      "timeout_s": 180,
      "min_tests": 7,
      "max_skipped": 0
    },
    {
      "id": "target",
      "executable": "python",
      "args": [
        "-m",
        "unittest",
        "discover",
        "-s",
        "pilot_tests",
        "-t",
        ".",
        "-p",
        "test_must_pass_reachable.py"
      ],
      "timeout_s": 180,
      "min_tests": 7,
      "max_skipped": 0,
      "must_pass": [
        "pilot_tests.test_must_pass_reachable.MustPassReachableTest.test_every_test_discovery_really_runs_is_accepted",
        "pilot_tests.test_must_pass_reachable.MustPassReachableTest.test_a_required_test_that_discovery_never_runs_is_rejected",
        "pilot_tests.test_must_pass_reachable.MustPassReachableTest.test_a_test_whose_file_may_not_exist_is_not_rejected",
        "pilot_tests.test_must_pass_reachable.MustPassReachableTest.test_a_duplicated_required_test_is_rejected",
        "pilot_tests.test_must_pass_reachable.MustPassReachableTest.test_a_name_that_cannot_be_a_unittest_test_id_is_rejected",
        "pilot_tests.test_must_pass_reachable.MustPassReachableTest.test_only_the_offending_tests_are_reported",
        "pilot_tests.test_must_pass_reachable.MustPassReachableTest.test_without_must_pass_nothing_changes"
      ]
    }
  ],
  "judge": [],
  "limits": {
    "max_usd": 0.5,
    "max_iterations": 3
  },
  "tools": [
    "edit_file"
  ]
}
