+IMPL_NODES = ("orchestrator", "worker", "synthesize", "evaluator")     # the nodes graph.py can build either way
+IMPL_KINDS = ("fake", "llm")
+
+
+def parse_impl_overrides(items):
+    """['evaluator=llm', ...] -> {'evaluator': 'llm'}. The last item for a node wins, as with --model."""
+    out = {}
+    for item in items or []:
+        node, sep, kind = item.partition("=")
+        if not sep or not node or not kind:
+            raise ConfigError(f"impl override must look like 'node=kind', got {item!r}")
+        if node not in IMPL_NODES:
+            raise ConfigError(f"unknown node {node!r}; nodes are {list(IMPL_NODES)}")
+        if kind not in IMPL_KINDS:
+            raise ConfigError(f"node {node!r} must be 'fake' or 'llm', got {kind!r}")
+        out[node] = kind
+    return out
+
+
