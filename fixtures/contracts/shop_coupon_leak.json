{
  "contract": "shop_coupon_leak",
  "version": 1,
  "inputs": {
    "workspace": "fixtures/repos/shop",
    "issue": "A customer sometimes gets a coupon discount at checkout without entering a coupon, usually right after another customer used one. Fix it. Do not change the tests."
  },
  "scope": {
    "writable": [
      "src/**"
    ],
    "protected": [
      "tests/**"
    ]
  },
  "artifacts": [
    {
      "path": "SUMMARY.json",
      "type": "json",
      "schema": "claims_v2"
    }
  ],
  "validation": [
    {
      "id": "unit",
      "executable": "python",
      "args": [
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests",
        "-t",
        ".",
        "-p",
        "test_regression.py"
      ],
      "timeout_s": 60,
      "min_tests": 5,
      "max_skipped": 0
    },
    {
      "id": "target",
      "executable": "python",
      "args": [
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests",
        "-t",
        ".",
        "-p",
        "test_order_isolation.py"
      ],
      "timeout_s": 60,
      "min_tests": 5,
      "max_skipped": 0,
      "must_pass": [
        "tests.test_order_isolation.OrderIsolationTest.test_coupon_checkout",
        "tests.test_order_isolation.OrderIsolationTest.test_no_coupon_after_a_coupon_checkout",
        "tests.test_order_isolation.OrderIsolationTest.test_coupon_between_two_plain_checkouts",
        "tests.test_order_isolation.OrderIsolationTest.test_plain_quote_after_a_coupon_checkout",
        "tests.test_order_isolation.OrderIsolationTest.test_plain_checkout_after_a_promotional_quote"
      ]
    }
  ],
  "judge": [],
  "limits": {
    "max_usd": 0.5,
    "max_iterations": 3
  },
  "tools": [
    "search_files"
  ]
}
